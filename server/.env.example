ANTHROPIC_API_KEY=
# Required only if your Anthropic key is org-level (not workspace-scoped): wrkspc_...
ANTHROPIC_WORKSPACE_ID=
VOYAGE_API_KEY=
# Voyage is now MongoDB — Atlas "al-…" keys use this endpoint. Leave default unless you have a legacy "pa-…" key.
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
PINECONE_API_KEY=
PINECONE_INDEX=docsagent
PORT=3001
# optional tuning knobs
ANTHROPIC_MODEL=claude-haiku-4-5
TOP_K=4
GUARD_MIN_SCORE=0.35
